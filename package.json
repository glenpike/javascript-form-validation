{
  "name": "dwp-test",
  "version": "1.0.0",
  "description": "A JavaScript validated web-form for DWP's coding test.",
  "main": "src/main.js",
  "scripts": {
    "start": "npx serve -l 3000 ./src",
    "test": "playwright test",
    "lint:html": "html-validate src",
    "lint:js": "eslint '**/*.mjs' 'src/**/*.js' 'tests/*'",
    "lint:css": "eslint 'src/**/*.css'",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:css",
    "js:obfuscate": "node scripts/rename-js.mjs hide",
    "js:restore": "node scripts/rename-js.mjs restore"
  },
  "author": "github@glenpike.co.uk",
  "license": "MIT",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "last 2 Samsung versions",
    "not dead"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/css": "^2.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "eslint-plugin-compat": "^7.0.2",
    "html-validate": "^11.4.0",
    "playwright": "^1.62.1"
  }
}
